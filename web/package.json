{
  "name": "pc-flow-web",
  "private": true,
  "version": "1.8.0",
  "description": "PC 机箱风道与散热 2D 仿真（网页版，移植自 MATLAB 版 v4.9.0）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "diag": "vite-node scripts/diag.ts",
    "profile": "vite-node scripts/profile.ts",
    "bench": "vite-node scripts/bench.ts",
    "steady": "vite-node scripts/steady.ts",
    "compare-data": "vite-node scripts/compareData.ts",
    "build:single": "tsc --noEmit && vite build --mode single",
    "release": "npm run build:single && node -e \"require('fs').mkdirSync('release',{recursive:true});require('fs').copyFileSync('dist-single/index.html','release/pcflow-web.html')\""
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "preact": "^11.0.0"
  }
}
